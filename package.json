    "@xterm/xterm": "^6.0.0",
    "agentation": "3.0.2",
    "agentation-mcp": "1.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "draco3dgltf": "^1.5.7",
    "lucide-react": "^1.43.0",
    "meshoptimizer": "^1.2.0",
    "node-pty": "^1.1.0",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
