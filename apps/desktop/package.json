    "@xterm/xterm": "^6.0.0",
    "ignore": "^7.0.5",
    "lucide-react": "^0.577.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tldraw": "^4.5.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "agentation": "^3.0.2",
    "electron": "^36.3.2",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.9",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
